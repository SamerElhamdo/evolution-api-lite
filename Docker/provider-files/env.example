# Provider Files Server Configuration
# ===================================
# هذا الملف يحتوي على مثال لمتغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وعدّل القيم حسب احتياجك

# Port السيرفر (افتراضي: 5656)
PROVIDER_PORT=5656

# Prefix للمجلدات (افتراضي: evolution)
PROVIDER_PREFIX=evolution

# مسار التخزين داخل الـ container (لا تغيره إلا إذا كنت تعرف ما تفعل)
PROVIDER_STORAGE_DIR=/app/storage

# API Key - يجب أن يطابق AUTHENTICATION_API_KEY في Evolution API
# ⚠️ مهم جداً: يجب أن يكون نفس القيمة في Evolution API
AUTHENTICATION_API_KEY=BQYHJGJHJ

