# Evolution API Lite - Dokploy Environment Variables
# Copy these variables to Dokploy and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_PORT=8080
SERVER_URL=https://your-domain.com
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# ============================================
# AUTHENTICATION (IMPORTANT: Change API_KEY!)
# ============================================
AUTHENTICATION_API_KEY=your-secure-api-key-here-change-this
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://user:pass@postgres:5432/evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true

# PostgreSQL Container Settings
POSTGRES_USER=user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=evolution

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
CACHE_REDIS_SAVE_INSTANCES=false

# ============================================
# R2 SESSION STORAGE (Cloudflare R2)
# ============================================
R2_SESSION_STORAGE_ENABLED=false
S3_ENABLED=false
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_ENDPOINT=your_account_id.r2.cloudflarestorage.com
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_USE_SSL=true

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WEBSOCKET_ENABLED=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=ERROR,WARN,DEBUG,INFO
LOG_COLOR=true
LANGUAGE=en

